{
  "expo": {
    "name": "TP3 - Herramientas Nativas",
    "slug": "tp3-herramientas-nativas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tp3herramientas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Esta aplicación requiere acceso a la cámara para tomar fotos y escanear códigos QR.",
        "NSLocationWhenInUseUsageDescription": "Esta aplicación requiere acceso a la ubicación para obtener coordenadas GPS.",
        "NSFaceIDUsageDescription": "Esta aplicación utiliza Face ID para autenticación biométrica."
      }
    },
    "android": {
      "package": "com.pdeisc.rn3herramientas",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que la app acceda a la cámara para capturar fotos y leer códigos QR."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que la app acceda a tu ubicación para obtener coordenadas GPS."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que la app use autenticación biométrica."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "424b7591-6471-4b28-81ee-4da80f35cb49"
      }
    },
    "owner": "pocorena-luis"
  }
}
