# Server
PORT=3000
NODE_ENV=development
API_VERSION=1
PUBLIC_URL="https://app.example.com"
API_BASE_URL="https://app.example.com/api"

# Database (MySQL / TiDB Cloud / PlanetScale)
DATABASE_URL="mysql://surf:surfpassword@localhost:3306/surf_rental"

# JWT
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# MercadoPago
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MP_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"
MP_WEBHOOK_SECRET="your-mp-webhook-secret"

# Cloudinary (required for stateless cheap hosting: Render/Railway/Koyeb/Fly)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Cors
CORS_ORIGIN="https://app.example.com"

# Clave especial para modificacion de comisiones de sede (obligatoria en produccion)
AGENCY_COMMISSION_PASSWORD="change-me-in-production"
